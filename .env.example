# .env.example
# Copy to .env for local development: cp .env.example .env
# Real secrets never go in this file or in git.
APP_NAME=surge
APP_ENV=development   # development | test | production

DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/surge
DB_POOL_MAX_SIZE=10

TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/surge_test

REDIS_URL=redis://localhost:6379/0
TEST_REDIS_URL=redis://localhost:6379/15